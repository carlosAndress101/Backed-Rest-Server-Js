{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Life of a request \u2014 PUT /api/product/:id",
    "locale": "en",
    "viewBox": [1060, 600],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "identity",
        "label": "Identity check",
        "focus": ["client", "app", "authn", "mongo"],
        "note": "The Bearer JWT is verified, then its token version is compared with the user in MongoDB."
      },
      {
        "id": "policy",
        "label": "Policy and validation",
        "focus": ["authn", "authz", "validate"],
        "note": "Roles are checked first; ownership is deferred to the service; zod validates params and body."
      },
      {
        "id": "write",
        "label": "Guarded write",
        "focus": ["service", "mongo", "app", "client"],
        "note": "Ownership is enforced inside the same findOneAndUpdate that writes, so there is no check-then-write gap."
      }
    ]
  },
