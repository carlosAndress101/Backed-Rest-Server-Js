      "dot": "rose",
      "title": "401 vs 403",
      "items": [
        "Bad, expired or revoked token (old tv) \u2192 401",
        "Role or ownership refusal \u2192 403 Not allowed"
      ]
    },
    {
      "dot": "emerald",
      "title": "Validation",
      "items": [
